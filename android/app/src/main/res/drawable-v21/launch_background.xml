<?xml version="1.0" encoding="utf-8"?>
<!-- Splash before Android 12: plum ink with the bubble in the middle, the
     same frame the welcome screen opens on, so launch is one continuous
     image instead of a white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_ink" />
    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
